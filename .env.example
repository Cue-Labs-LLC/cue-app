# Example environment variables — copy to `.env` (gitignored) and fill in real values.
# This file is NOT exhaustive: it documents optional integrations that are easy to miss.
# The full, authoritative list of environment variables lives in CLAUDE.md
# ("Environment Variables" section).

# ── LangSmith tracing (optional observability) ─────────────────────────────
# Traces LangChain/LangGraph runs — the SMS eval agent judge (eval_sms_plans
# --agent-judge), the chat agent, and strategist generation — so you can inspect
# each agent run, its tool calls, and token usage at https://smith.langchain.com.
# When LANGSMITH_TRACING is unset/false, nothing is sent and there is no overhead.
# NOTE: enabling this sends prompt + tool-result data to LangSmith's cloud. It is a
# global toggle (affects ALL LangChain calls in the process), so leave it off in
# environments where that data must not leave the box.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=sms-plan-eval

# ── Langfuse evals (Instagram support agent) ───────────────────────────────
# Hosted eval datasets + experiment runs for `python manage.py eval_ig_agent`.
# Create a project at https://cloud.langfuse.com (or self-host) and paste its keys.
# Only the eval command uses these; unset = the command errors cleanly.
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
# The org the eval answers as (seed_local_data sets this for you):
# IG_EVAL_ORG_SLUG=familiar-faces
